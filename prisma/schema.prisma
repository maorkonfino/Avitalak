generator client {
  provider = "prisma-client-js"
}

// Supabase setup:
// DATABASE_URL  → transaction pooler URL  (used at runtime by Vercel)
// DIRECT_URL    → direct connection URL   (used by prisma migrate / db push)
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  phone        String?
  password     String
  role         UserRole      @default(USER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
  waitlist     Waitlist[]
}

model Service {
  id            String        @id @default(cuid())
  name          String        @unique
  nameEn        String?
  description   String?
  duration      Int
  price         Float
  category      String
  icon          String?
  active        Boolean       @default(true)
  availableDays String        @default("0,1,2,3,4")
  startTime     String        @default("09:00")
  endTime       String        @default("18:00")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  appointments  Appointment[]
  waitlist      Waitlist[]
}

model Appointment {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId    String
  service      Service           @relation(fields: [serviceId], references: [id])
  date         DateTime
  endDate      DateTime
  status       AppointmentStatus @default(PENDING)
  notes        String?
  reminderSent Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([date])
  @@index([userId])
  @@index([status])
}

model Waitlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id])
  date      DateTime
  timeSlot  String
  notified  Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([serviceId])
  @@index([active])
}

model Settings {
  id                               String   @id @default(cuid())
  newAppointmentEmailSubject       String   @default("אישור קביעת תור - Avital")
  newAppointmentEmailBody          String   @default("שלום {{customerName}},\n\nהתור שלך נקבע בהצלחה!\n\n📅 תאריך: {{date}}\n🕐 שעה: {{time}}\n💅 שירות: {{serviceName}}\n⏱️ משך: {{duration}} דקות\n💰 מחיר: ₪{{price}}\n\nנתראה בקרוב!\nאביטל")
  updatedAppointmentEmailSubject   String   @default("עדכון תור - Avital")
  updatedAppointmentEmailBody      String   @default("שלום {{customerName}},\n\nהתור שלך עודכן!\n\n📅 תאריך: {{date}}\n🕐 שעה: {{time}}\n💅 שירות: {{serviceName}}\n\nנתראה בקרוב!\nאביטל")
  cancelledAppointmentEmailSubject String   @default("ביטול תור - Avital")
  cancelledAppointmentEmailBody    String   @default("שלום {{customerName}},\n\nהתור שלך בוטל.\n\n📅 תאריך: {{date}}\n🕐 שעה: {{time}}\n💅 שירות: {{serviceName}}\n\nניתן לקבוע תור חדש דרך האתר.\n\nאביטל")
  reminderEmailSubject             String   @default("תזכורת לתור מחר - Avital")
  reminderEmailBody                String   @default("שלום {{customerName}},\n\nתזכורת לתור מחר!\n\n📅 תאריך: {{date}}\n🕐 שעה: {{time}}\n💅 שירות: {{serviceName}}\n\nמחכה לראות אותך!\nאביטל")
  waitlistNotificationSubject      String   @default("תור התפנה! - Avital")
  waitlistNotificationBody         String   @default("שלום {{customerName}},\n\n🎉 תור התפנה!\n\n📅 תאריך: {{date}}\n💅 שירות: {{serviceName}}\n\nמהרי לקבוע!\nאביטל")
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt
}
